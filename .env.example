# JSONBin.io credentials for the Bess journal.
# Create a private bin at https://jsonbin.io, seed it with the entries JSON,
# then copy this file to .env and fill in both values.
#
# IMPORTANT: escape every "$" in the master key as "\$".
# Vite runs .env values through dotenv-expand, which treats $NAME as a variable
# reference and silently expands it to an empty string. JSONBin keys look like
# $2a$10$SGQ1o... so the "$SGQ1o..." segment would vanish, leaving a truncated
# key and a 401 on every request. Quoting does NOT help — only backslashes do.
#
#   wrong:  VITE_JSONBIN_MASTER_KEY=$2a$10$SGQ1o2Ld...
#   wrong:  VITE_JSONBIN_MASTER_KEY='$2a$10$SGQ1o2Ld...'
#   right:  VITE_JSONBIN_MASTER_KEY=\$2a\$10\$SGQ1o2Ld...
#
# Vite inlines these into the client bundle at build time, so anyone who loads
# the site can read the key. Use a bin dedicated to this journal.
VITE_JSONBIN_BIN_ID=
VITE_JSONBIN_MASTER_KEY=
