# Lives in public/ so Vite copies it into dist/ and it ships with the deployed
# folder. netlify.toml at the repo root is ignored when only dist/ is uploaded.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=2592000

/audio/*
  Cache-Control: public, max-age=2592000
